# Cadena de conexión de MongoDB Atlas. Sin esto el club de lectura no levanta.
# Formato: mongodb+srv://usuario:password@cluster.xxxx.mongodb.net/14febrero
MONGODB_URI=

# Opcional. Google Books funciona sin key, pero con una gratuita sube el límite
# de peticiones por hora. Se saca en console.cloud.google.com (Books API).
GOOGLE_BOOKS_API_KEY=
